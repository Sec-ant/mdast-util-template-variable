{
  "name": "mdast-util-template-variable",
  "description": "mdast extension to parse and serialize template variables",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.js",
  "exports": {
    ".": {
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/es/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sec-ant/mdast-util-template-variable.git"
  },
  "homepage": "https://github.com/Sec-ant/mdast-util-template-variable",
  "bugs": {
    "url": "https://github.com/Sec-ant/mdast-util-template-variable/issues",
    "email": "zezhengwu@proton.me"
  },
  "keywords": [
    "unist",
    "mdast",
    "mdast-util",
    "util",
    "utility",
    "markdown",
    "markup",
    "template",
    "variable",
    "template-variable",
    "curly",
    "braces",
    "curly-braces"
  ],
  "author": {
    "name": "Ze-Zheng Wu"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "update-hooks": "simple-git-hooks",
    "clean": "rimraf dist",
    "lint": "biome lint .",
    "format:prettier": "pretty-quick",
    "format:biome": "biome format . --write",
    "format": "pnpm -s format:prettier && pnpm -s format:biome",
    "type-check": "tsc --noEmit",
    "check:biome": "biome check --write .",
    "check": "pnpm -s format:prettier && pnpm -s check:biome",
    "prebuild": "pnpm -s check && pnpm -s type-check",
    "dev": "vite",
    "build:es": "vite build",
    "build:cjs": "tsx ./scripts/build-cjs.ts",
    "build": "conc \"pnpm:build:es\" \"pnpm:build:cjs\"",
    "postbuild:es": "tsc --declarationDir ./dist/es",
    "postbuild:cjs": "tsc --declarationDir ./dist/cjs",
    "preview": "vite preview",
    "prepublishOnly": "pnpm -s build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.7.2",
    "concurrently": "^9.2.1",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-to-markdown": "^2.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d"
}
